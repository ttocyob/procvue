#ifndef PROCVUE_VERSION_H
#define PROCVUE_VERSION_H

/* Generated by meson vcs_tag(): "git describe" of the working tree, or the
 * meson project_version() fallback when building without a .git directory
 * (release tarballs, git-archive zips). */
#define PROCVUE_VERSION "@VCS_TAG@"

#endif /* PROCVUE_VERSION_H */
